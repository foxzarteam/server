# Copy to `server/.env` and/or `server/.env.local` (same pattern as az_web).
# Nest loads both; `.env.local` overrides `.env` for local secrets — keep both out of git.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the service_role secret (Dashboard → Project Settings → API → “service_role”).
# Do NOT use sb_publishable_* here — admin/auth DB reads will fail and login returns 401.
SUPABASE_SERVICE_KEY=your_service_role_secret
# Alias (same value): some repos use this name instead.
# SUPABASE_SERVICE_ROLE_KEY=
LIVE=false

PORT=3001
API_PREFIX=api

# NODE_ENV=development
# Required in production (fail-closed):
# ADMIN_INTERNAL_KEY=long-random-secret-shared-with-az_web
# ALLOWED_ORIGINS=https://your-az-web-domain.com
# ALLOW_OTP_DEV=false

# PAN field encryption (AES-256-GCM). 64 hex chars = 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAN_ENCRYPTION_KEY=
# Required when NODE_ENV=production. Dev falls back to a non-secret local key.

# Firebase Admin — POST /api/otp/verify-firebase and POST /api/customer/login (project azapp-77130)
FIREBASE_PROJECT_ID=azapp-77130
# Local dev: save downloaded key as server/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Vercel: paste full JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
